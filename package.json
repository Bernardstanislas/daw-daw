{
  "name": "daw-daw",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "build:wasm": "cargo build --release --target wasm32-unknown-unknown --manifest-path crates/daw-wasm/Cargo.toml && cp crates/daw-wasm/target/wasm32-unknown-unknown/release/daw_wasm.wasm public/daw-engine.wasm",
    "dev:web": "pnpm build:wasm && vite",
    "build:web": "pnpm build:wasm && tsc && vite build"
  },
  "dependencies": {
    "@fontsource-variable/figtree": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-dialog": "^2.8.4",
    "@tauri-apps/plugin-opener": "^2",
    "@tauri-apps/plugin-process": "^2.4.0",
    "@tauri-apps/plugin-updater": "^2.14.1",
    "dseg": "^0.46.0",
    "immer": "^11.2.10",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^6.0.2",
    "typescript": "~6.0.3",
    "vite": "^8.0.16"
  }
}
