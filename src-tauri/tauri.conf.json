{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "daw-daw",
  "version": "0.1.0",
  "identifier": "com.dawdaw.app",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "daw-daw",
        "width": 1480,
        "height": 920,
        "minWidth": 1000,
        "minHeight": 640,
        "dragDropEnabled": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app",
      "dmg",
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "Music",
    "shortDescription": "A small DAW",
    "createUpdaterArtifacts": true,
    "macOS": {
      "signingIdentity": "-"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDY2MzExQkI5M0Q3NjNGODUKUldTRlAzWTl1UnN4Wm1kM2E4eG1UelYwNm9WVXFzLzRXNzJZSXFXNG8zSXNBSE9xcGdrSlN6MGQK",
      "endpoints": [
        "https://github.com/Bernardstanislas/daw-daw/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
